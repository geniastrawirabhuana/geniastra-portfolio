# Optional for local development; omit this to use http://localhost:3000.
# Production requires a real public HTTPS URL. Never commit real secret values.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=GENIASTRA
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_CV_URL=

# Supabase project connection. Get these from the Supabase Dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Trusted migration tasks only. Never expose this as a NEXT_PUBLIC variable.
SUPABASE_SECRET_KEY=

# Optional server-side project translation service (never use NEXT_PUBLIC_).
DEEPL_AUTH_KEY=
# Optional: defaults to the official Free or Pro endpoint based on the key.
DEEPL_API_URL=
